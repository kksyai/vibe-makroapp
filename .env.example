# Vite Configuration
# Путь: .env.example (пример конфигурации)

# Development Server
VITE_HOST=127.0.0.1
VITE_PORT=3000

# Environment
NODE_ENV=development

# Security (для продакшена)
# Uncomment для production окружения
# VITE_CORS_ORIGIN=https://yourdomain.com
# VITE_API_URL=https://api.yourdomain.com

# Feature Flags (опционально)
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DEBUG=false